      ],
      "provenance": "winutil@70c23c80641d7370532af2f619b2842658600842:config/appx.json (WPFAppxMicrosoft_WindowsFeedbackHub -> Microsoft.WindowsFeedbackHub, WPFAppxMicrosoft_GetHelp -> Microsoft.GetHelp) + atlas@ec3c4058ad0ebd5289a4d07f2af5d6c86e8d455f:Atlas.Appx/Domain/Removal.ps1 (Microsoft.WindowsFeedbackHub*, Microsoft.GetHelp*)",
      "actions": [
        {
          "type": "command",
          "order": 1,
          "description": "Quitar los paquetes AppX (registrados y provisionados)",
          "fileName": "powershell.exe",
          "arguments": [
            "-NoProfile",
            "-NonInteractive",
            "-Command",
            "$f=@('Microsoft.WindowsFeedbackHub','Microsoft.GetHelp');foreach($n in $f){Get-AppxPackage -AllUsers -Name $n | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue;Get-AppxProvisionedPackage -Online | Where-Object DisplayName -like $n | Remove-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue}"
          ],
          "ignoreExitCode": true
        }
      ]
    }
  ]
