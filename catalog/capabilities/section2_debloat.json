            "-NoProfile",
            "-NonInteractive",
            "-Command",
            "$f=@('Microsoft.BingNews','Microsoft.BingWeather','Microsoft.ZuneMusic','Microsoft.ZuneVideo','Microsoft.MicrosoftSolitaireCollection','Microsoft.Getstarted','Microsoft.MicrosoftOfficeHub','MicrosoftCorporationII.QuickAssist','Clipchamp.Clipchamp','SpotifyAB.SpotifyMusic','Disney.37853FC22B2CE','Microsoft.MixedReality.Portal','Microsoft.Windows.DevHome');foreach($n in $f){Get-AppxPackage -AllUsers -Name $n | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue;Get-AppxProvisionedPackage -Online | Where-Object DisplayName -like $n | Remove-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue}"
