<Window x:Class="Evo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EVO Optimizer — Inventario de capacidades"
        Width="1000" Height="700">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de estado de detección de Windows -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="StatusText" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="BuildText" Foreground="#777777" Margin="0,4,0,0" />
            <TextBlock x:Name="EditionText" Foreground="#777777" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Secciones del inventario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" BorderBrush="#CCCCCC" CornerRadius="4" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Capabilities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="#EEEEEE" Margin="0,4,0,4" Padding="0,4,0,4">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}" Foreground="#555555" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="MetaText" Foreground="#777777" FontSize="11" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                                            <Button Content="Simular" Click="Simulate_Click" Margin="0,0,6,0" Padding="8,4" />
                                                            <Button Content="Aplicar" Click="Apply_Click" Margin="0,0,6,0" Padding="8,4" />
                                                            <Button Content="Deshacer" Click="Undo_Click" Padding="8,4" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock x:Name="ReasonText" Foreground="#B00020" FontStyle="Italic" FontSize="11" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Sin capacidades todavía" Foreground="#777777" FontStyle="Italic" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Área de resultados -->
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="#CCCCCC" CornerRadius="4" Padding="8" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Resultados" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock x:Name="ResultsText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
