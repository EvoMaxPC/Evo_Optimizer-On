<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Evo.Detection</RootNamespace>
    <AssemblyName>Evo.Detection</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Evo.Core\Evo.Core.csproj" />
  </ItemGroup>

  <!-- El catalogo de versiones es DATO (REQ-003): se copia junto al binario. -->
  <ItemGroup>
    <None Include="..\..\catalog\windows-releases.json"
          Link="catalog\windows-releases.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
