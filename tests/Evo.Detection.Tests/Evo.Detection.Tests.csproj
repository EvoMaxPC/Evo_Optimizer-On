<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <!-- Los analizadores de xUnit no deben romper el build de los tests;
         el codigo de producto si mantiene TreatWarningsAsErrors (heredado). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>Evo.Detection.Tests</RootNamespace>
    <AssemblyName>Evo.Detection.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Evo.Detection\Evo.Detection.csproj" />
  </ItemGroup>

  <!-- El test necesita el catalogo de versiones tal cual (dato, no copia de codigo). -->
  <ItemGroup>
    <None Include="..\..\catalog\windows-releases.json"
          Link="catalog\windows-releases.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
